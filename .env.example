# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (postgres-app container from infra repo)
DATABASE_URL="postgresql://trackify:trackify_secret@localhost:5432/trackify_db?schema=public"

# JWT (for BE1 — Auth module)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# File Upload (for BE1/BE3 — Multer)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
