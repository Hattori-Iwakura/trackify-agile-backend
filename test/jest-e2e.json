{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    ".*generated/prisma/client(\\.js)?$": "<rootDir>/__mocks__/prisma-client.ts",
    ".*generated/prisma/enums(\\.js)?$": "<rootDir>/__mocks__/prisma-enums.ts",
    "^(\\.\\..*)\\.js$": "$1"
  }
}
